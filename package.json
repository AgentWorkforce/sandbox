{
  "name": "chief",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/onboard.mjs",
    "install:services": "node scripts/install.mjs",
    "doctor": "node scripts/chief-doctor.mjs",
    "validate": "node scripts/validate-config.mjs",
    "config:migrate": "node scripts/migrate-config.mjs",
    "config:test": "node --test scripts/lib/chief-runtime.test.mjs",
    "factory:test": "node --test scripts/lib/factory-contract.test.mjs",
    "factory:bootstrap": "node scripts/factory-control.mjs bootstrap",
    "factory:status": "node scripts/factory-control.mjs status",
    "factory:first-task": "node scripts/factory-control.mjs dispatch-workspace-task",
    "factory:promote": "node scripts/factory-control.mjs promote-issue",
    "factory:create": "node scripts/factory-control.mjs create-task",
    "factory:comment": "node scripts/factory-control.mjs comment",
    "senses": "node scripts/chief-senses.mjs run",
    "senses:probe": "node scripts/chief-senses.mjs probe",
    "senses:once": "node scripts/chief-senses.mjs once",
    "senses:status": "node scripts/chief-senses.mjs status",
    "senses:stop": "node scripts/chief-senses.mjs stop",
    "chief": "sh scripts/chief.sh",
    "chief:view": "sh scripts/chief.sh view",
    "chief:brain": "sh scripts/chief.sh brain",
    "up": "agent-relay node up",
    "status": "agent-relay node status",
    "digest:now": "launchctl kickstart -k gui/501/com.agentworkforce.chief.digest",
    "orgchart": "node tools/orgchart/serve.mjs",
    "orgchart:test": "node --test tools/orgchart/serve.test.mjs",
    "cloud:context:build": "node scripts/build-chief-cloud-context.mjs",
    "cloud:context:check": "node scripts/build-chief-cloud-context.mjs --check",
    "cloud:typecheck": "node --check personas/chief-khaliq/agent.mjs && node --check scripts/build-chief-cloud-context.mjs && node --check scripts/deploy-chief-cloud.mjs && node --check scripts/verify-chief-cloud-bundle.mjs",
    "cloud:test": "node --test scripts/lib/chief-cloud-context.test.mjs personas/chief-khaliq/agent.test.mjs",
    "cloud:compile:check": "node scripts/verify-chief-cloud-bundle.mjs",
    "cloud:deploy:khaliq:dry-run": "node scripts/deploy-chief-cloud.mjs --dry-run --no-prompt",
    "cloud:deploy:khaliq": "node scripts/deploy-chief-cloud.mjs"
  },
  "dependencies": {
    "@agentworkforce/runtime": "4.1.37"
  },
  "devDependencies": {
    "agentworkforce": "4.1.37"
  },
  "engines": {
    "node": ">=22"
  }
}
