.DS_Store
.env
node_modules/
.workforce/
.npm-cache/
senses/
.agentworkforce/*
!.agentworkforce/trajectories/
tools/orgchart/.state/
# Per-machine runtime state: the dispatch ledger records which agent names this
# machine has claimed, so it is meaningless on any other machine.
state/
# Per-machine: generated by npm run setup, or copied from the committed
# teams.<principal>.json variant for whichever principal runs this machine.
teams.json
# Same split, same reason: the active dispatch contract carries an absolute
# cloneRoot, so only the factory.<principal>.config.json variant is committed.
factory.config.json
.worktrees/
relay-1467/

# Per-machine opencode runtime config — carries live credentials, never tracked
opencode.json
