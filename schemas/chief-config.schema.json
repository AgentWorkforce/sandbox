{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chief configuration",
  "type": "object",
  "required": [
    "principal",
    "agent",
    "brainRoot",
    "workspace",
    "senses",
    "recipes"
  ],
  "properties": {
    "principal": {
      "type": "object",
      "required": [
        "name",
        "timezone"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "handle": {
          "type": "string"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": [
        "name",
        "displayName"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "brainRoot": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "workspace": {
      "type": "object",
      "required": [
        "name",
        "requireUnifiedDataPlaneId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "requireUnifiedDataPlaneId": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "senses": {
      "type": "object",
      "required": [
        "localDir",
        "remotePaths",
        "scopes"
      ],
      "properties": {
        "localDir": {
          "type": "string",
          "minLength": 1
        },
        "remotePaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "uniqueItems": true
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^relayfile:fs:(read|write):"
          },
          "uniqueItems": true
        },
        "refreshBeforeSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 1800
        }
      },
      "additionalProperties": false
    },
    "recipes": {
      "type": "object",
      "description": "Factory recipe selection. Chief chooses the recipe; the target repository's factory.config.json owns everything else about dispatch.",
      "required": [
        "default",
        "labels"
      ],
      "properties": {
        "default": {
          "enum": [
            "single",
            "workflow",
            "team"
          ]
        },
        "labels": {
          "type": "object",
          "required": [
            "single",
            "workflow",
            "team"
          ],
          "properties": {
            "single": {
              "type": "string",
              "minLength": 1
            },
            "workflow": {
              "type": "string",
              "minLength": 1
            },
            "team": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
