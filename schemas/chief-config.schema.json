{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chief configuration",
  "type": "object",
  "required": ["principal", "agent", "brainRoot", "workspace", "senses", "work"],
  "properties": {
    "principal": {
      "type": "object",
      "required": ["name", "timezone"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "handle": { "type": "string" },
        "timezone": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": ["name", "displayName"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "displayName": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "brainRoot": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "workspace": {
      "type": "object",
      "required": ["name", "requireUnifiedDataPlaneId"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "requireUnifiedDataPlaneId": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "senses": {
      "type": "object",
      "required": ["localDir", "remotePaths", "scopes"],
      "properties": {
        "localDir": { "type": "string", "minLength": 1 },
        "remotePaths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^/" },
          "uniqueItems": true
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^relayfile:fs:(read|write):" },
          "uniqueItems": true
        },
        "refreshBeforeSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 1800
        }
      },
      "additionalProperties": false
    },
    "work": {
      "type": "object",
      "required": ["humanSystem", "agentSystem", "factory"],
      "properties": {
        "humanSystem": { "const": "linear" },
        "agentSystem": { "const": "github" },
        "factory": {
          "type": "object",
          "required": [
            "execution",
            "teamKey",
            "titlePrefix",
            "readinessState",
            "readinessLabel",
            "defaultRecipe",
            "recipeLabels",
            "mergePolicy"
          ],
          "properties": {
            "execution": { "const": "cloud" },
            "teamKey": { "type": "string", "minLength": 1 },
            "titlePrefix": { "type": "string", "minLength": 1 },
            "readinessState": { "type": "string", "minLength": 1 },
            "readinessLabel": { "type": "string", "minLength": 1 },
            "defaultRecipe": {
              "enum": ["single", "workflow", "team"]
            },
            "recipeLabels": {
              "type": "object",
              "required": ["single", "workflow", "team"],
              "properties": {
                "single": { "type": "string", "minLength": 1 },
                "workflow": { "type": "string", "minLength": 1 },
                "team": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "mergePolicy": { "const": "never" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
