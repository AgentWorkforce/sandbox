{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chief team roster",
  "type": "object",
  "required": [
    "principal",
    "senses",
    "recipes",
    "team",
    "agents"
  ],
  "properties": {
    "principal": {
      "type": "object",
      "required": [
        "slug",
        "name",
        "timezone"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Names the brain directory under principals/."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "handle": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "senses": {
      "type": "object",
      "required": [
        "remotePaths",
        "scopes"
      ],
      "properties": {
        "remotePaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "recipes": {
      "type": "object",
      "description": "Factory recipe selection. Chief chooses the recipe; Chief's active factory.config.json owns everything else about dispatch.",
      "required": [
        "default",
        "labels"
      ],
      "properties": {
        "default": {
          "enum": [
            "single",
            "workflow",
            "team"
          ]
        },
        "labels": {
          "type": "object",
          "required": [
            "single",
            "workflow",
            "team"
          ],
          "properties": {
            "single": {
              "type": "string",
              "minLength": 1
            },
            "workflow": {
              "type": "string",
              "minLength": 1
            },
            "team": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "description": "Optional v1 compatibility policy. New installations let Agent Relay own the active workspace and require converged data-plane IDs.",
      "required": [
        "name",
        "requireUnifiedDataPlaneId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "requireUnifiedDataPlaneId": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "team": {
      "type": "string",
      "minLength": 1
    },
    "autoSpawn": {
      "type": "boolean"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "cli",
          "role",
          "task"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "cli": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false,
  "description": "The one per-principal file. Names the principal, the resident agent roster the broker spawns, and the senses least-privilege declaration. Everything else is derived (brainRoot from principal.slug) or owned elsewhere (the workspace by agent-relay, the Factory dispatch contract by Chief's active factory.config.json)."
}
