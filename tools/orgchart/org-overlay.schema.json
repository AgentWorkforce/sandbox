{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentworkforce.dev/schemas/chief-org-overlay-v1.json",
  "title": "Chief external organization overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "principal", "agents"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "reportsTo": {
            "type": "string",
            "minLength": 1
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
